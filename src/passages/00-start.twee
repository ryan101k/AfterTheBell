:: StoryInit
<<set $playerName = "최은호">>
<<set $chapter = 0>>
<<set $scene = "title">>
<<set $playerPattern = {
  "face": 0,
  "delegate": 0,
  "avoid": 0
}>>
<<set $prologue = {
  "openedSiwooMessage": false,
  "answeredSiwoo": false,
  "heardHallway": false,
  "openedDoor": false
}>>
<<set $routeUnlocks = {
  "dangerous": false,
  "freedom": false,
  "childhood": false,
  "business": false
}>>
<<set $romanceOpen = {
  "sera": false,
  "yujin": false,
  "chaerin": false
}>>
<<set $chapter1 = {
  "recognizedNarae": false,
  "hasLedger": false,
  "seraStayed": false,
  "seraAccompanies": false,
  "yujinStayed": false,
  "chaerinRefused": false
}>>
<<set $economy = {
  "cash": 12800000,
  "earned": 0,
  "evidence": 1
}>>
<<set $chapter2 = {
  "chaerinIgnores": 0,
  "marketApproach": "",
  "analysisPaid": false,
  "tradingPaid": false,
  "trioRoute": false,
  "seraAwakened": false,
  "yujinAwakened": false,
  "chaerinAwakened": false
}>>
<<set $clearedEndings = {}>>

:: 시작 [title menu nobr]
<section class="title-screen">
  <div class="title-screen__shade"></div>
  <div class="title-screen__content">
    <p class="title-kicker">AFTER THE CLOSING BELL</p>
    <h1>폐장 후, 우리</h1>
    <p class="title-copy">시장은 닫혔지만<br>끝내 정리하지 못한 관계는 그제야 움직이기 시작했다.</p>
    <nav class="title-menu" aria-label="시작 메뉴">
      <button type="button" class="title-menu__primary" data-vn-passage="프롤로그 · 폐장">새 게임</button>
      <<if Save.browser.size > 0>>
        <button type="button" data-vn-action="continue">이어하기</button>
      <<else>>
        <button type="button" disabled>이어하기</button>
      <</if>>
      <button type="button" data-vn-action="saves">불러오기</button>
    </nav>
  </div>
  <p class="title-version">CHAPTER 2 · 0.3</p>
</section>
