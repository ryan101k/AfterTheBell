:: 달력 · 오늘의 약속 [autosave nobr]
<<set _currentWeek = Math.floor($freeSchedule.slot / 2) + 1>>
<<set _currentPeriod = $freeSchedule.slot % 2 is 0 ? "평일 저녁" : "주말">>
<section class="vn-scene vn-scene--room vn-scene--schedule">
  <div class="vn-scene__shade"></div>
  <div class="vn-dialogue vn-dialogue--narration schedule-dialogue">
    <div class="schedule-header">
      <div>
        <p class="schedule-kicker">세 주 동안의 달력</p>
        <h2><<print $freeSchedule.title>></h2>
      </div>
      <p class="schedule-now"><strong><<print ["첫째 주", "둘째 주", "셋째 주"][_currentWeek - 1]>></strong><span><<print _currentPeriod>></span></p>
    </div>
    <ol class="schedule-timeline" aria-label="세 주 동안 적은 약속">
      <<for _slot = 0; _slot lt $freeSchedule.totalSlots; _slot++>>
        <<set _slotWeek = Math.floor(_slot / 2) + 1>>
        <<set _slotPeriod = _slot % 2 is 0 ? "평일" : "주말">>
        <<if _slot lt $freeSchedule.order.length>>
          <<set _slotKey = $freeSchedule.order[_slot]>>
          <li class="schedule-slot is-filled"><span><<print _slotWeek>>주 · <<print _slotPeriod>></span><strong><<print setup.freeScheduleLabels[_slotKey]>></strong></li>
        <<elseif _slot is $freeSchedule.slot>>
          <li class="schedule-slot is-current"><span><<print _slotWeek>>주 · <<print _slotPeriod>></span><strong>오늘</strong></li>
        <<else>>
          <li class="schedule-slot"><span><<print _slotWeek>>주 · <<print _slotPeriod>></span><strong>아직 적지 않음</strong></li>
        <</if>>
      <</for>>
    </ol>
    <p class="schedule-guide">한 번 적은 이름 곁에는 다음 약속이 떠올랐다. 적지 않은 이름도 마음에서 사라지지는 않았다.</p>
    <<include $freeSchedule.optionsPassage>>
  </div>
</section>

:: 달력 · 다음 빈칸 [nobr]
<<if $freeSchedule.slot gte $freeSchedule.totalSlots>>
  <<set $freeSchedule.active = false>>
  <<goto $freeSchedule.finishPassage>>
<<else>>
  <<goto "달력 · 오늘의 약속">>
<</if>>

:: 2장 · 사건 뒤의 빈 달력 [chapter2 autosave nobr]
<<set $freeSchedule = {
  "mode": "dangerous-preconfession",
  "active": true,
  "title": "사건이 끝난 뒤",
  "totalSlots": 6,
  "slot": 0,
  "last": "",
  "order": [],
  "optionsPassage": "2장 · 달력에 적을 이름",
  "finishPassage": "2장 · 달력에 남은 저녁",
  "visits": {
    "sera": 0,
    "yujin": 0,
    "chaerin": 0,
    "siwooNarae": 0,
    "alone": 0
  },
  "flags": {
    "securedArchive": false,
    "namedOwnEvening": false
  }
}>>
<section class="vn-scene vn-scene--room">
  <div class="vn-scene__shade"></div>
  <div class="vn-dialogue vn-dialogue--narration">
    <p>사건이 끝난 뒤 달력에는 약속이 아니라 빈칸이 먼저 생겼다.</p>
    <p>새라는 되찾은 작업실에 있었고, 유진은 사건이 없는 비번을 맞았으며, 채린은 처음으로 목적 없는 토요일을 비워 두었다. 누구도 당장 오라고 재촉하지 않았다.</p>
    <p>시우는 나래와 사건 자료를 정리할 사람이 필요하다고 했고, 나는 아무도 만나지 않는 저녁도 한 번쯤은 약속처럼 남겨 보고 싶었다.</p>
    <p>나는 앞으로 세 주의 평일 저녁과 주말에 동그라미를 쳤다. 여섯 자리였다. 모든 부탁에 답할 수는 있었지만, 그러면 또 내가 원하는 순서만 사라질 것 같았다.</p>
    <p class="vn-beat">이번에는 먼저 생긴 약속을 따라가는 대신, 누구에게 갈지 달력에 내 손으로 적기로 했다.</p>
    [[첫 번째 빈칸에 이름을 적는다->달력 · 오늘의 약속]]
  </div>
</section>

:: 2장 · 달력에 적을 이름 [nobr]
<div class="schedule-choices">
  <<if $freeSchedule.visits.sera is 0>>
    <div class="schedule-choice schedule-choice--sera">
      <<link "새라가 되찾은 작업실에 간다.">>
        <<set $freeSchedule.visits.sera += 1>>
        <<set $freeSchedule.slot += 1>>
        <<set $freeSchedule.last = "sera">>
        <<run $freeSchedule.order.push("sera")>>
        <<set $dangerousAffection.sera += 4>>
        <<goto "2장 · 색이 마르는 오후">>
      <</link>>
      <small>고쳐 줄 물건은 없다고 했다.</small>
    </div>
  <<elseif $freeSchedule.visits.sera is 1>>
    <div class="schedule-choice schedule-choice--sera">
      <<link "새라와 동네 화방에 간다.">>
        <<set $freeSchedule.visits.sera += 1>>
        <<set $freeSchedule.slot += 1>>
        <<set $freeSchedule.last = "sera">>
        <<run $freeSchedule.order.push("sera")>>
        <<set $dangerousAffection.sera += 4>>
        <<goto "2장 · 노란색 한 통">>
      <</link>>
      <small>새라는 그림에 안 맞는 색을 골라 달라고 했다.</small>
    </div>
  <</if>>

  <<if $freeSchedule.visits.yujin is 0>>
    <div class="schedule-choice schedule-choice--yujin">
      <<link "유진이 취소했던 저녁을 다시 잡는다.">>
        <<set $freeSchedule.visits.yujin += 1>>
        <<set $freeSchedule.slot += 1>>
        <<set $freeSchedule.last = "yujin">>
        <<run $freeSchedule.order.push("yujin")>>
        <<set $dangerousAffection.yujin += 4>>
        <<goto "2장 · 취소해도 남은 약속">>
      <</link>>
      <small>이번에는 확인할 일도, 구조할 사람도 없다.</small>
    </div>
  <<elseif $freeSchedule.visits.yujin is 1>>
    <div class="schedule-choice schedule-choice--yujin">
      <<link "유진이 혼자 다니던 오락실에 간다.">>
        <<set $freeSchedule.visits.yujin += 1>>
        <<set $freeSchedule.slot += 1>>
        <<set $freeSchedule.last = "yujin">>
        <<run $freeSchedule.order.push("yujin")>>
        <<set $dangerousAffection.yujin += 4>>
        <<goto "2장 · 비번의 오락실">>
      <</link>>
      <small>유진은 혼자 하던 곡 하나를 남겨 뒀다.</small>
    </div>
  <</if>>

  <<if $freeSchedule.visits.chaerin is 0>>
    <div class="schedule-choice schedule-choice--chaerin">
      <<link "채린이 비워 둔 토요일을 받는다.">>
        <<set $freeSchedule.visits.chaerin += 1>>
        <<set $freeSchedule.slot += 1>>
        <<set $freeSchedule.last = "chaerin">>
        <<run $freeSchedule.order.push("chaerin")>>
        <<set $dangerousAffection.chaerin += 4>>
        <<goto "2장 · 잔액이 부족한 버스">>
      <</link>>
      <small>차도 수행원도 부르지 않겠다고 했다.</small>
    </div>
  <<elseif $freeSchedule.visits.chaerin is 1>>
    <div class="schedule-choice schedule-choice--chaerin">
      <<link "채린이 읽는 첫 장을 기다린다.">>
        <<set $freeSchedule.visits.chaerin += 1>>
        <<set $freeSchedule.slot += 1>>
        <<set $freeSchedule.last = "chaerin">>
        <<run $freeSchedule.order.push("chaerin")>>
        <<set $dangerousAffection.chaerin += 4>>
        <<goto "2장 · 다 읽지 않은 첫 장">>
      <</link>>
      <small>책갈피는 아직 첫 장에 꽂혀 있다.</small>
    </div>
  <</if>>

  <<if $freeSchedule.visits.siwooNarae is 0>>
    <div class="schedule-choice schedule-choice--side">
      <<link "시우와 나래의 자료 정리를 돕는다.">>
        <<set $freeSchedule.visits.siwooNarae = 1>>
        <<set $freeSchedule.flags.securedArchive = true>>
        <<set $freeSchedule.slot += 1>>
        <<set $freeSchedule.last = "siwooNarae">>
        <<run $freeSchedule.order.push("siwooNarae")>>
        <<set $playerPattern.delegate += 1>>
        <<goto "2장 · 비밀번호를 묻지 않은 저녁">>
      <</link>>
      <small>시우는 비밀번호를 정할 사람이 하나 더 필요하다고 했다.</small>
    </div>
  <</if>>

  <<if $freeSchedule.visits.alone is 0>>
    <div class="schedule-choice schedule-choice--alone">
      <<link "아무도 부르지 않고 혼자 저녁을 보낸다.">>
        <<set $freeSchedule.visits.alone = 1>>
        <<set $freeSchedule.flags.namedOwnEvening = true>>
        <<set $freeSchedule.slot += 1>>
        <<set $freeSchedule.last = "alone">>
        <<run $freeSchedule.order.push("alone")>>
        <<set $playerPattern.face += 1>>
        <<goto "2장 · 아무도 기다리지 않은 저녁">>
      <</link>>
      <small>냉장고에는 내가 고르지 않은 재료가 남아 있다.</small>
    </div>
  <</if>>
</div>

:: 2장 · 비밀번호를 묻지 않은 저녁 [chapter2 autosave nobr]
<section class="vn-scene vn-scene--room" data-standees="narae:neutral,siwoo:neutral">
  <div class="vn-scene__shade"></div>
  <div class="vn-dialogue vn-dialogue--narration">
    <p>시우가 잡은 곳은 회사도 내 집도 아닌 구립도서관의 작은 회의실이었다. 나래는 사건 자료가 든 저장 장치 두 개를 가져왔다.</p>
    <p>하나는 유진에게 넘길 원본, 다른 하나는 새라가 열람할 피해 기록이었다. 같은 문서를 복사해도 볼 수 있는 범위는 달라야 했다.</p>
    <p>시우는 내게 비밀번호를 정해 달라고 하지 않았다. 자기가 만든 암호 키 절반을 나래에게, 나머지 절반을 내게 건넸다.</p>
    <p>“둘 중 한 사람이 마음대로 열 수 없게 하는 겁니다.”</p>
    <p>“은호 씨가 잊어버리면요?” 나래가 물었다.</p>
    <p>“그럼 다시 셋이 만나야죠.”</p>
    <p>시우는 아무렇지 않게 말했지만, 나래는 `다시`라는 말을 들은 뒤에야 저장 장치를 가방에 넣었다.</p>
    <p>작업이 끝나고 나래가 빈 종이컵을 정리했다. 시우의 컵에는 설탕 봉지가 뜯기지 않은 채 남아 있었다.</p>
    <p>“단 건 안 드십니까?”</p>
    <p>“나래 씨가 안 드신다길래 그냥 맞춘 겁니다.”</p>
    <p>“저는 남에게 맞추라고 말한 적 없습니다.” 나래는 잠시 생각하다 자기 명함 뒤에 근처 식당 이름을 적었다. “그러니 다음에는 각자 먹고 싶은 걸 고르죠.”</p>
    <p>두 사람 모두 약속이라고 부르지 않았다. 그래도 시우는 명함을 지갑의 투명한 칸에 넣었다.</p>
    <p>돌아오는 길에 나는 암호 키가 든 봉투를 만졌다. 서로를 믿는다는 이유로 하나의 비밀번호를 공유하지 않는 관계도 있었다.</p>
    [[달력의 다음 빈칸으로 돌아간다->달력 · 다음 빈칸]]
  </div>
</section>

:: 2장 · 아무도 기다리지 않은 저녁 [chapter2 autosave nobr]
<section class="vn-scene vn-scene--room">
  <div class="vn-scene__shade"></div>
  <div class="vn-dialogue vn-dialogue--narration">
    <p>휴대전화를 끈 것은 아니었다. 화면이 보이도록 식탁 위에 두고, 누구에게도 먼저 연락하지 않았다.</p>
    <p>전에는 이런 밤이면 연락이 오지 않는 이유부터 생각했다. 새라가 작업 중인지, 유진이 출동했는지, 채린이 다른 약속을 잡았는지 추측하다 보면 혼자 있는 시간도 결국 다른 사람의 것이 됐다.</p>
    <p>냉장고에는 새라가 고르지 않은 재료가 남아 있었다. 나는 오이를 빼고 볶음밥을 만들었다. 유진이 싫어할 만큼 매운 소스를 넣고, 채린이라면 값부터 물을 편의점 맥주를 땄다.</p>
    <p>게임에 접속했지만 친구 목록은 열지 않았다. 혼자 할 수 있는 낡은 스테이지를 골라 두 번 실패하고 세 번째에 통과했다.</p>
    <p>좋아하는 것을 고르는 데 다른 사람의 실망이 필요하지 않은 밤이었다.</p>
    <p>잠들기 전 달력의 빈칸에 짧게 적었다.</p>
    <p class="vn-beat">매운 볶음밥. 싼 맥주. 혼자 하는 게임도 싫지 않음.</p>
    <p>아무도 읽지 않을 문장이었지만 지우지 않았다. 다음에 누군가 내 취향을 알아맞히려 할 때, 먼저 말할 답이 하나 생겼다.</p>
    [[달력의 다음 빈칸으로 돌아간다->달력 · 다음 빈칸]]
  </div>
</section>

:: 2장 · 달력에 남은 저녁 [chapter2 autosave nobr]
<section class="vn-scene vn-scene--room">
  <div class="vn-scene__shade"></div>
  <div class="vn-dialogue vn-dialogue--narration">
    <p>세 번째 주말이 끝나자 처음에는 비어 있던 여섯 자리에 서로 다른 저녁이 남아 있었다.</p>
    <<if $freeSchedule.visits.sera is 2>>
      <p>새라의 칸에는 작업실의 빈 의자와 노란 물감이 남았다. 새라는 쓸모를 부탁하지 않았고, 나는 그림에 맞지 않는 색을 골랐다.</p>
    <<elseif $freeSchedule.visits.sera is 1>>
      <p>새라의 칸에는 작업실의 빈 의자만 남았다. 다시 화방에 가자는 약속은 아직 날짜를 얻지 못했다.</p>
    <<else>>
      <p>새라의 새 작업실 사진은 대화창 위쪽으로 밀려났다. 열쇠 없이 찾아갈 수 있는 주소를 받았지만 이번 달력에는 적지 않았다.</p>
    <</if>>
    <<if $freeSchedule.visits.yujin is 2>>
      <p>유진의 칸에는 취소해도 남은 저녁과 틀린 박자가 있었다. 사건이 없는 비번을 두 번이나 함께 낭비했다.</p>
    <<elseif $freeSchedule.visits.yujin is 1>>
      <p>유진과는 취소했던 저녁을 다시 만들었다. 오락실 위치를 알려 주겠다는 메시지는 아직 답하지 않은 채 남았다.</p>
    <<else>>
      <p>유진은 비번 날짜를 한 번 보냈다가 지웠다. 확인할 일이 없는 연락을 보내는 데에는 여전히 이유가 필요해 보였다.</p>
    <</if>>
    <<if $freeSchedule.visits.chaerin is 2>>
      <p>채린의 칸에는 잔액이 부족했던 버스와 다 읽지 않은 첫 장이 있었다. 다음 버스까지의 십삼 분은 누구도 사지 않았다.</p>
    <<elseif $freeSchedule.visits.chaerin is 1>>
      <p>채린은 오천 원짜리 헌책을 샀다. 첫 장을 읽는 날은 정하지 않았지만, 책을 대신 읽어 줄 사람도 부르지 않았다.</p>
    <<else>>
      <p>채린이 비워 둔 토요일에는 다른 회의가 들어갔다. 일정표 사진은 지워지지 않았고, 빈칸을 만들었다는 사실만 남았다.</p>
    <</if>>
    <<if $freeSchedule.flags.securedArchive>>
      <p>시우와 나래에게 쓴 한 칸은 누구의 호감도 올리지 않았다. 대신 비밀번호를 나누어 가진 채 다시 만날 이유가 생겼다.</p>
    <</if>>
    <<if $freeSchedule.flags.namedOwnEvening>>
      <p>혼자 쓴 한 칸에는 내 취향만 적혀 있었다. 누군가를 기다리지 않은 시간이 관계의 빈칸은 아니었다.</p>
    <</if>>
    <p>달력을 오래 보아도 누구를 더 좋아하는지는 적혀 있지 않았다. 다만 내가 먼저 찾아간 저녁과 다음으로 미룬 약속만은 지워지지 않았다.</p>
    [[달력에 남은 마음을 읽는다->2장 · 세 사람에게서 배운 취향]]
  </div>
</section>

/% 3bef301 이전 저장의 현재 패시지와 동적 패시지 이름을 새 달력 장면으로 이관한다. %/
:: 자유 일정 · 선택 [nobr]
<<goto "달력 · 오늘의 약속">>

:: 자유 일정 · 복귀 [nobr]
<<goto "달력 · 다음 빈칸">>

:: 2장 · 고백 전 자유 일정 [nobr]
<<goto "2장 · 사건 뒤의 빈 달력">>

:: 2장 · 자유 일정 선택지 [nobr]
<<include "2장 · 달력에 적을 이름">>

:: 2장 · 자유 일정이 남긴 것 [nobr]
<<goto "2장 · 달력에 남은 저녁">>
