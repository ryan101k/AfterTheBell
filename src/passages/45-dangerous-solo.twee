        <<set $dangerousAffection.yujin += 10>>
        <<set $affectionNotice = "♥ 유진 호감도 +10 · 필요하지 않은 날에도 만날 수 있다">>
        <<goto "3Y · 꺼진 위치 공유">>
      <</link>>
      <<link "유진 없이는 아무것도 못 하겠다고 안긴다  [유진 ♥ -4]">>
        <<set $dangerousSolo.yujinReleased = false>>
        <<set $dangerousAffection.yujin -= 4>>
        <<set $affectionNotice = "♡ 유진 호감도 -4 · 가장 위험한 보상">>
        <<goto "3Y · 꺼진 위치 공유">>
      <</link>>
    </div>
  </div>
</section>

:: 3Y · 꺼진 위치 공유 [chapter3 autosave nobr]
<section class="vn-scene vn-scene--room">
  <div class="vn-scene__shade"></div>
  <div class="vn-dialogue vn-dialogue--narration">
    <div class="vn-character-card">
