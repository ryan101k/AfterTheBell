        <<goto "3Y · 돌아온 사람">>
      <</link>>
      <<link "오늘만은 전화를 끄고 나와 함께 있어 달라고 한다  [유진 ♥ +3]">>
        <<set $dangerousSolo.yujinReturnedOffDuty = false>>
        <<set $dangerousAffection.yujin += 3>>
        <<set $affectionNotice = "♥ 유진 호감도 +3 · 곁에 남았지만 역할 밖의 자신은 고르지 못했다">>
        <<goto "3Y · 돌아온 사람">>
