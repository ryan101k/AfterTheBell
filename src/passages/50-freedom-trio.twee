        <<set $freedom.soheePresence = false>><<set $affection.sohee -= 3>>
        <<set $affectionNotice = "♡ 소희 호감도 -3 · 부담은 덜었지만 자기 자리를 지울 이유도 완성했다">>
        <<goto "5장 · 보내지 않은 데모">>
      <</link>>
    </div>
