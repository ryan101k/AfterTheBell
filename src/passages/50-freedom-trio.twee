        <<set $freedom.yunaSpace = false>><<set $affection.yuna -= 3>>
        <<set $affectionNotice = "♡ 유나 호감도 -3 · 사실은 바로잡았지만 유나의 선택도 대신했다">>
        <<goto "5장 · 공개되지 않은 일요일">>
