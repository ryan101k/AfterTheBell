:: 2장 · 돌아갈 주소 [chapter2 autosave nobr]
<<set $chapter = 2>>
<<set $scene = "sera-home">>
<<set $chapter2 = {
  "trioRoute": false,
  "seraPath": "",
  "yujinPath": "",
  "chaerinPath": "",
  "seraBoundary": false,
  "yujinBoundary": false,
  "chaerinBoundary": false,
  "recognizedMethod": false,
