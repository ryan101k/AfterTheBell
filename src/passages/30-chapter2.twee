        <<goto "2장 · 진통제 봉투">>
      <</link>>
      <<link "오늘은 쉬고 내일 아침 상태만 알려 달라고 부탁한다.">>
        <<set $chapter2.yujinSickChoice = "morning">>
        <<set $dangerousAffection.yujin += 8>>
        <<set $affectionNotice = "♥ 강유진 관계도 +8 · 즉시 확인하는 대신 다시 연락할 약속을 믿었다">>
        <<goto "2장 · 진통제 봉투">>
      <</link>>
