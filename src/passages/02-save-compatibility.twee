<<set $chapter3 = Object.assign({
  "seraAnswered": false,
  "yujinAnswered": false,
  "chaerinAnswered": false,
  "eunhoDisappeared": false,
  "acceptedResponsibility": false,
  "answerStyle": "",
  "seraBoundaryStyle": "",
