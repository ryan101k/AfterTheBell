:: PassageHeader [nobr]
<<set $playerName = $playerName ?? "최은호">>
<<set $chapter = $chapter ?? 0>>
<<set $scene = $scene ?? "unknown">>
<<set $playerPattern = Object.assign({
  "face": 0,
  "delegate": 0,
  "avoid": 0
}, $playerPattern ?? {})>>
<<set $prologue = Object.assign({
  "openedSiwooMessage": false,
  "answeredSiwoo": false,
  "heardHallway": false,
  "openedDoor": false,
  "memoryStance": ""
}, $prologue ?? {})>>
<<set $routeUnlocks = Object.assign({
  "dangerous": false,
  "freedom": false,
  "childhood": false,
  "business": false
}, $routeUnlocks ?? {})>>
<<set $dangerousOutcome = $dangerousOutcome ?? "unresolved">>
<<set $freedomMode = $freedomMode ?? "locked">>
<<set $freedomOrigin = $freedomOrigin ?? "">>
<<set $affection = Object.assign({
  "chaewon": 0,
  "yuna": 0,
  "sohee": 0
}, $affection ?? {})>>
<<set $dangerousAffection = Object.assign({
  "sera": 0,
  "yujin": 0,
  "chaerin": 0
}, $dangerousAffection ?? {})>>
<<if $dangerousAffectionVersion is undefined>>
  <<set $dangerousAffection.sera = Math.min(100, Math.round($dangerousAffection.sera * 100 / 30))>>
  <<set $dangerousAffection.yujin = Math.min(100, Math.round($dangerousAffection.yujin * 100 / 30))>>
  <<set $dangerousAffection.chaerin = Math.min(100, Math.round($dangerousAffection.chaerin * 100 / 30))>>
  <<set $dangerousAffectionVersion = 2>>
<</if>>
<<set $dangerousSolo = Object.assign({
  "route": "",
  "seraRisk": 0,
  "seraBoundary": false,
  "seraAsked": false,
  "seraReturnedByChoice": false,
  "yujinRisk": 0,
  "yujinEqual": false,
  "yujinReleased": false,
  "yujinReturnedOffDuty": false,
  "chaerinRisk": 0,
  "chaerinPublicBoundary": false,
  "chaerinStop": false,
  "chaerinAcceptedConsequence": false
}, $dangerousSolo ?? {})>>
<<set $affectionNotice = $affectionNotice ?? "">>
<<set $dialogueLog = Array.isArray($dialogueLog) ? $dialogueLog : []>>
<<set $freedom = Object.assign({
  "existingNamed": false,
  "contextHonest": false,
  "serviceDays": 0,
  "afterTopic": "",
  "concreteInvite": false,
  "firstSeat": "",
  "chaewonRoom": false,
  "yunaSpace": false,
  "soheePresence": false,
  "morningPromise": false,
  "disclosedExisting": false,
  "disclosureRewarded": false,
  "chaewonAsked": false,
  "yunaClarified": false,
  "soheeStayed": false,
  "nextMeetingChosen": false
}, $freedom ?? {})>>
<<set $romanceOpen = Object.assign({
  "sera": false,
  "yujin": false,
  "chaerin": false
}, $romanceOpen ?? {})>>
<<set $chapter1 = Object.assign({
  "seraStayed": false,
  "seraDoorClosed": false,
  "seraAskedBeforeTouching": false,
  "seraWaitedOutside": false,
  "seraCameBack": false,
  "eunhoWentOutside": false,
  "eunhoWantedReturn": false,
  "yujinOffDutyTea": false,
  "sharedHospitalChoice": false
}, $chapter1 ?? {})>>
<<set $chapter2 = Object.assign({
  "trioRoute": false,
  "seraPath": "",
  "yujinPath": "",
  "chaerinPath": "",
  "seraBoundary": false,
  "yujinBoundary": false,
  "chaerinBoundary": false,
  "recognizedMethod": false,
  "usedFather": false,
  "galaAttended": false,
  "chaerinKnewIdentity": false,
  "chaerinSlapped": false,
  "seraWorkTrusted": false,
  "seraSpokeForHerself": false,
  "eunhoWaitedForSera": "",
  "yujinOffDuty": false,
  "yujinAcceptedCare": false,
  "yujinDidNotInspect": false,
  "eunhoFirstContact": "",
  "seraLaundryChoice": "",
  "seraLunchChoice": "",
  "seraRainChoice": "",
  "yujinMovieChoice": "",
  "yujinConvenienceChoice": "",
  "yujinCancelledChoice": "",
  "yujinSickChoice": "",
  "chaerinHeardNo": false,
  "chaerinWalked": false,
  "chaerinWaited": false,
  "eunhoCheckedChaerin": "",
  "chaerinUnplannedVisit": "",
  "chaerinWalkChoice": "",
  "chaerinGiftChoice": "",
  "chaerinBusChoice": "",
  "chaerinRejectedChoice": "",
