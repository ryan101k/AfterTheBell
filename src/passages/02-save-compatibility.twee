:: PassageHeader [nobr]
<<set $playerName = $playerName ?? "최은호">>
<<set $chapter = $chapter ?? 0>>
<<set $scene = $scene ?? "unknown">>
<<set $playerPattern = Object.assign({
  "face": 0,
  "delegate": 0,
  "avoid": 0
}, $playerPattern ?? {})>>
<<set $prologue = Object.assign({
  "openedSiwooMessage": false,
  "answeredSiwoo": false,
  "heardHallway": false,
  "openedDoor": false
}, $prologue ?? {})>>
<<set $routeUnlocks = Object.assign({
  "dangerous": false,
  "freedom": false,
  "childhood": false,
  "business": false
}, $routeUnlocks ?? {})>>
<<set $romanceOpen = Object.assign({
  "sera": false,
  "yujin": false,
  "chaerin": false
}, $romanceOpen ?? {})>>
<<set $chapter1 = Object.assign({
  "recognizedNarae": false,
  "hasLedger": false,
  "seraStayed": false,
  "seraAccompanies": false,
  "yujinStayed": false,
  "chaerinRefused": false
}, $chapter1 ?? {})>>
<<set $clearedEndings = $clearedEndings ?? {}>>
