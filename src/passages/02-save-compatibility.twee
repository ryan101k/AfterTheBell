  "firstMeeting": false,
  "rivalsMetAlone": false,
  "rulesWritten": false,
  "newHomeCrossed": false,
  "boundaryCount": 0,
  "repairScore": 0
}, $chapter3 ?? {})>>
<<set $clearedEndings = $clearedEndings ?? {}>>
