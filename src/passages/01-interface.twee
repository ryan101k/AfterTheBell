:: StoryInterface
<div id="vn-app">
  <header class="vn-toolbar">
    <div class="vn-toolbar__brand"><span>AFTER THE BELL</span><strong>폐장 후, 우리</strong></div>
    <div class="vn-toolbar__chapter">CH. <span data-vn-chapter>0</span></div>
    <div class="vn-toolbar__actions">
      <button type="button" class="vn-bgm-toggle" data-vn-action="bgm" aria-pressed="false" aria-label="배경음악 켜기" title="배경음악 켜기"><span data-bgm-icon aria-hidden="true">♪×</span><span>BGM</span></button>
      <button type="button" data-vn-action="backlog" aria-haspopup="dialog">대화 기록</button>
      <button type="button" data-vn-action="saves">저장 · 불러오기</button>
      <button type="button" data-vn-action="restart">타이틀</button>
    </div>
  </header>
  <aside class="affection-hud" data-affection-hud hidden aria-label="인물별 호감도">
    <span><i>♥</i> <em data-affection-label="0">채원</em> <strong data-affection-value="0">0</strong><small data-affection-stage="0"></small></span>
    <span><i>♥</i> <em data-affection-label="1">유나</em> <strong data-affection-value="1">0</strong><small data-affection-stage="1"></small></span>
    <span><i>♥</i> <em data-affection-label="2">소희</em> <strong data-affection-value="2">0</strong><small data-affection-stage="2"></small></span>
  </aside>
  <div class="affection-toast" data-affection-toast hidden role="status" aria-live="polite"></div>
  <section class="vn-backlog" data-vn-backlog hidden role="dialog" aria-modal="true" aria-labelledby="vn-backlog-title">
    <div class="vn-backlog__panel">
      <header class="vn-backlog__header">
        <div>
          <span>STORY LOG</span>
          <h2 id="vn-backlog-title">이전 대화</h2>
        </div>
        <button type="button" data-vn-backlog-close aria-label="대화 기록 닫기">닫기</button>
      </header>
      <div class="vn-backlog__body" data-vn-backlog-body></div>
    </div>
  </section>
  <main id="passages"></main>
</div>
