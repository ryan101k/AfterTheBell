:: 3장 · 세 번의 고백 [chapter3 autosave nobr]
<<set $chapter = 3>>
<<set $scene = "separate-confessions">>
<<set $chapter3 = {
  "answerStyle": "",
  "seraBoundaryStyle": "",
  "yujinBoundaryStyle": "",
  "chaerinBoundaryStyle": "",
